{
  "name": "radar-rider",
  "version": "3.0.0",
  "private": true,
  "description": "Radar Rider - seguranca comunitaria para riders na Irlanda e no Reino Unido.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "db:migrate:deploy": "prisma migrate deploy",
    "deploy": "npm run db:migrate:deploy && npm run build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run lint && npm run typecheck",
    "test": "node --experimental-strip-types --test t/*.test.mjs",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "next": "^16.2.11",
    "next-auth": "^4.24.15",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "prisma": "^6.19.3",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.21",
    "sharp": "^0.35.3"
  }
}
