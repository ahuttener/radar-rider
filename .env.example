# Radar Rider - variaveis de ambiente.
#
# LOCAL:     copie para .env e preencha. O .env NUNCA vai para o Git.
# PRODUCAO:  cadastre uma a uma no painel da Hostinger, em
#            Sites > radarrider.com > Variaveis de ambiente.
#            Reinicie a aplicacao depois de cadastrar.

# --- Banco de dados (MySQL da Hostinger) -----------------------------------
# Formato: mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO
#
# Use 127.0.0.1, NAO localhost. Na Hostinger "localhost" faz o driver tentar
# socket unix em vez de TCP, e a conexao falha sem dizer o porque. Ja custou
# horas de investigacao aqui uma vez; nao troque de volta.
#
# Se a senha tiver caracteres especiais (@ : / ?), use percent-encoding.
DATABASE_URL="mysql://usuario:senha@127.0.0.1:3306/radar_rider"

# --- Sessao ----------------------------------------------------------------
# Gere um valor aleatorio longo e guarde so no painel:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-longo"

# Endereco publico do site. Precisa bater EXATAMENTE com o que o navegador usa,
# incluindo o www, senao o login redireciona errado e o link do e-mail quebra.
NEXTAUTH_URL="https://www.radarrider.com"

# --- E-mail (SMTP da Hostinger) --------------------------------------------
# Caixa criada no hPanel em Emails > Contas de e-mail.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="contato@radarrider.com"
SMTP_PASS="a-senha-da-caixa-de-email"
# Aparece como remetente para quem recebe.
MAIL_FROM="Radar Rider <contato@radarrider.com>"

# --- Identidade jurídica e privacidade ------------------------------------
# Obrigatórios antes do lançamento público. Como o controlador é uma pessoa
# física, use o nome civil e um endereço postal válido para notificações.
LEGAL_CONTROLLER_NAME="Nome civil do responsável"
LEGAL_CONTROLLER_ADDRESS="Endereço postal completo, Irlanda"
PRIVACY_EMAIL="contato@radarrider.com"

# Página externa de apoio. O link só abre quando a pessoa toca no botão.
NEXT_PUBLIC_SUPPORT_URL="https://buymeacoffee.com/brdeals"

# Segredo do cron de retenção (/api/cron/retencao). Gere um valor aleatório longo
# e configure um cron de hora em hora no hPanel:
#   curl -s -H "Authorization: Bearer SEU_SEGREDO" https://www.radarrider.com/api/cron/retencao
# Sem esta variável a rota responde 503 e a faxina não roda.
CRON_SECRET="troque-por-um-valor-aleatorio-longo"
