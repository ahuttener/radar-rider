# Radar Rider - variaveis de ambiente.
#
# LOCAL:     copie para .env e preencha. O .env NUNCA vai para o Git.
# PRODUCAO:  cadastre uma a uma no painel da Hostinger, em
#            Sites > radarrider.com > Variaveis de ambiente.
#            Reinicie a aplicacao depois de cadastrar.

# --- Banco de dados (MySQL da Hostinger) -----------------------------------
# Formato: mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO
# O host normalmente e localhost quando o app roda na mesma hospedagem.
# Se a senha tiver caracteres especiais (@ : / ?), use percent-encoding.
DATABASE_URL="mysql://usuario:senha@localhost:3306/radar_rider"

# --- Sessao ----------------------------------------------------------------
# Gere um valor aleatorio longo e guarde so no painel:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-longo"

# Endereco publico do site. Precisa bater EXATAMENTE com o que o navegador usa,
# incluindo o www, senao o login redireciona errado e o link do e-mail quebra.
NEXTAUTH_URL="https://www.radarrider.com"

# --- E-mail (SMTP da Hostinger) --------------------------------------------
# Caixa criada no hPanel em Emails > Contas de e-mail.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="contato@radarrider.com"
SMTP_PASS="a-senha-da-caixa-de-email"
# Aparece como remetente para quem recebe.
MAIL_FROM="Radar Rider <contato@radarrider.com>"
