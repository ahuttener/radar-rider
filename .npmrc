# O next-auth 4 declara nodemailer ^7 como peer opcional e o projeto usa o ^9.
# Sem esta linha o `npm install` do deploy da Hostinger morre com ERESOLVE e a
# esteira encerra ANTES de rodar `next build` — o app fica sem .next e o site
# responde 503 inteiro. Com ela a instalação passa direto e o build acontece.
legacy-peer-deps=true
