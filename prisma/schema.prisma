// Radar Rider — modelo de dados.
//
// Portado do supabase.sql. O Postgres protegia a privacidade com RLS e grants
// por coluna; aqui não existe RLS, então a MESMA proteção passa a ser
// responsabilidade do servidor: nenhuma rota pode devolver latitudePrivate,
// longitudePrivate ou userId de um alerta para quem não é staff.
// Isso está centralizado em src/lib/alert-visibility.ts — não montar resposta
// de alerta à mão em rota nenhuma.

// engineType = "client" tira o motor Rust do caminho. Na jaula CloudLinux da
// Hostinger o motor nativo não sobe: ele abre um runtime tokio próprio, não
// consegue criar as threads e aborta com "PANIC: timer has gone away", o que
// derrubava TODA rota que tocasse o banco. Sem ele, as consultas passam pelo
// driver MySQL em JavaScript configurado em src/lib/prisma.ts.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  moderator
  admin
}

enum AlertCategory {
  intimidacao
  roubo
  grupo_hostil
  via_perigosa
  acidente
  outro
}

enum AlertStatus {
  active
  hidden
  removed
  expired
}

enum CountryCode {
  IE
  GB
}

enum ReportReason {
  identificacao
  falso
  odio
  privacidade
  outro
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  displayName     String    @db.VarChar(40)
  // Telefone com DDI, guardado no formato E.164 (ex: +353871234567). É opcional
  // na coluna porque contas criadas antes desta mudança não têm — mas o cadastro
  // novo exige (validado na rota /api/register).
  phone           String?   @db.VarChar(30)
  role            Role      @default(user)
  reputationScore Int       @default(0)
  emailVerifiedAt DateTime?
  // Momento da última troca de senha. A sessão é JWT e não há tabela de sessão
  // para apagar, então é isto que derruba token antigo: quem redefine a senha
  // espera expulsar quem estava logado, e sem esta coluna o invasor
  // continuaria dentro por até 30 dias.
  passwordChangedAt DateTime?
  // Exclusão de conta é marcada, não apagada na hora: os alertas precisam
  // continuar existindo para quem já confiou neles na rua.
  deletedAt       DateTime?
  // Enforcement de moderação. Suspensão é temporária (até suspendedUntil);
  // banimento é permanente (bannedAt preenchido). O login recusa ambos.
  suspendedUntil    DateTime?
  suspensionReason  String?   @db.VarChar(200)
  bannedAt          DateTime?
  banReason         String?   @db.VarChar(200)
  createdAt       DateTime  @default(now())

  alerts             Alert[]
  confirmations      AlertConfirmation[]
  reportsMade        AlertReport[]             @relation("ReportAuthor")
  moderationActions  ModerationAction[]
  deletionRequests   AccountDeletionRequest[]
  emailTokens        EmailToken[]
  pushSubscriptions  PushSubscription[]

  @@index([deletedAt])
}

// Inscrição para notificação push (Web Push). Guarda o endpoint do navegador e
// as chaves que cifram a mensagem. O `country` define quem recebe cada alerta —
// notificamos por país escolhido, NUNCA por localização exata (o app não
// rastreia posição em segundo plano; ver a decisão de privacidade no topo).
model PushSubscription {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String      @unique @db.VarChar(500)
  p256dh    String      @db.VarChar(200)
  auth      String      @db.VarChar(100)
  country   CountryCode
  createdAt DateTime    @default(now())

  @@index([country])
}

// Um único modelo para confirmar e-mail e para redefinir senha: o ciclo de vida
// é idêntico (token de uso único, com prazo) e separar em duas tabelas só
// duplicaria a lógica de expiração.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "verify_email" ou "reset_password"
  purpose   String    @db.VarChar(20)
  // Guarda o hash do token, nunca o token em si: vazamento do banco não pode
  // entregar links de redefinição de senha válidos.
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model Alert {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    AlertCategory
  description String        @db.VarChar(500)
  occurredAt  DateTime
  isOngoing   Boolean       @default(false)

  // Posição real. NUNCA sai numa resposta pública — só para moderação.
  latitudePrivate  Float
  longitudePrivate Float
  // Posição arredondada para ~100 m, que é a que o app mostra.
  latitudePublic   Float
  longitudePublic  Float

  status             AlertStatus @default(active)
  countryCode        CountryCode @default(IE)
  confirmationsCount Int         @default(0)
  expiresAt          DateTime
  createdAt          DateTime    @default(now())

  confirmations     AlertConfirmation[]
  reports           AlertReport[]
  moderationActions ModerationAction[]

  @@index([status, expiresAt])
  @@index([countryCode, status, createdAt])
  @@index([userId, createdAt])
}

model AlertConfirmation {
  id             String   @id @default(cuid())
  alertId        String
  alert          Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Distância de quem confirmou até o alerta. O servidor recusa acima de 2 km:
  // confirmação de longe não é testemunho.
  distanceMetres Int
  createdAt      DateTime @default(now())

  @@unique([alertId, userId])
}

model AlertReport {
  id         String       @id @default(cuid())
  alertId    String
  alert      Alert        @relation(fields: [alertId], references: [id], onDelete: Cascade)
  reportedBy String
  author     User         @relation("ReportAuthor", fields: [reportedBy], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?      @db.VarChar(300)
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now())

  @@unique([alertId, reportedBy])
  @@index([status, createdAt])
}

model ModerationAction {
  id          String   @id @default(cuid())
  alertId     String?
  alert       Alert?   @relation(fields: [alertId], references: [id], onDelete: SetNull)
  moderatorId String
  moderator   User     @relation(fields: [moderatorId], references: [id])
  action      String   @db.VarChar(40)
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model AccountDeletionRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  status    String   @default("open") @db.VarChar(20)
  createdAt DateTime @default(now())

  @@index([status])
}

// Rate limiting sem serviço externo: cada tentativa vira uma linha e o servidor
// conta as recentes por (bucket, identifier) dentro da janela. Precisa do banco
// porque a Hostinger roda vários processos e um contador em memória não seria
// compartilhado entre eles. Ver src/lib/rate-limit.ts.
model RateHit {
  id         String   @id @default(cuid())
  bucket     String   @db.VarChar(40)
  identifier String   @db.VarChar(190)
  createdAt  DateTime @default(now())

  @@index([bucket, identifier, createdAt])
}
